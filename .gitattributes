# Automatically normalize line endings for cross-platform collaboration
* text=auto

# Shell scripts must keep LF line endings
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts must keep CRLF line endings
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.keystore binary
*.jks binary
